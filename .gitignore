node_modules/
dist/
# zcode-server-cli 发行包 staging 输出，本地组装产物不入库。
dist-release/
# macOS CI 按架构隔离 electron-builder 输出目录，这些仍是构建产物。
packages/desktop/dist-*/
out/
prebuilds/
bundled-resources/
mock-cdn/
