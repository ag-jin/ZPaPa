packages/desktop/bundled-agents/
packages/desktop/bundled-tools/
packages/desktop/mock-cdn/
*.tsbuildinfo
.DS_Store
coverage/
.env.local
.env.*.local
.env
.VSCodeCounter
.idea/
.zed/
.cache
# CI 会跨任务保留这些下载缓存；不应进入 Git 未跟踪源码枚举。
/.electron-builder-cache/
/.electron-cache/
/.pnpm-store/
/.npm-cache/
.turbo/
z-work/
openclaw/
.run-logs/
.worktrees/
packages/stream-animate/dist-server/
packages/stream-animate/.stream-animate-data/
.codegraph
.mimosa/
# 集成分支曾混入 node-gyp 构建产物与 .playwright-mcp 临时快照；
# 入库由 scripts/ci/ci-repo-hygiene.mjs 在 CI 第一站拒绝，这里让本地 git add 也忽略它们。
.playwright-mcp/
*.o
.deps/
obj.target/
config.gypi
gyp-mac-tool
*.target.mk
binding.Makefile
# 这两条原来写成 build/Makefile、build/Release/*.node，含中间斜杠的 pattern
# 只相对 .gitignore 所在目录（仓库根）生效，匹配不到 packages/ax-macos/build/ 下的产物；
# 而 ci-repo-hygiene.mjs 的 denylist 用的是 (^|/)build/... 任意层级匹配。
# 宽严不一致时无斜杠 pattern 能拦住的产物会被 git add -A 重新扫进索引。
# 加 **/ 让忽略范围与门禁范围对齐。
**/build/Makefile
**/build/Release/*.node

# CUA 权限浮窗吸附用的 Swift 辅助二进制（由 prepare:macos-window-bounds 从
# packages/desktop/native/macos-window-bounds/main.swift 编出，源码入库、产物不入库）
packages/desktop/resources/macos-window-bounds/
# CUA Helper SEA 基座下载缓存（scripts/cua-helper-sea-base.mjs 落盘的官方 Node 22 运行时，纯下载产物）
/.tmp/
# Python 字节码（docker/plugin-eval/summarize.py 在主机上跑会生成）。
__pycache__/
*.pyc

# 本地工具运行产物，均可再生：桌面端 e2e 的截图/缓存/网络抓包，以及桌面
# 开发运行器的 Electron 下载缓存。
packages/desktop/.e2e-artifacts/
packages/desktop/.e2e-cache/
packages/desktop/.e2e-network-capture/
.zcode-runtime/

# ===== 工作区产物目录排除清单（spec §13 C10：**集中一处维护**）=====
# 本段是本仓库**唯一**的登记处：新增产物目录只写在这里，并同步
# `packages/services/src/wiki/wikiScan.ts` 的 SKIPPED_DIR_NAMES（扫描半边）。
# 清单同时驱动两半，故只改一处即可两处生效：
#   ① 版本控制：git 按本段忽略（oxfmt / prettier 的默认 --ignore-path 也读本文件）；
#   ② 扫描排除：workspace 首次搜索时按本文件**拷贝**生成 .zcodeignore，本段每一条
#      都会成为文件搜索的排除规则（见 packages/services/src/file/workspaceFileIgnore.ts）。
# 清单与 spec §13 C10 逐字一致：`.worktree/` · `.zcode/agent-memory/` · `.zcode/squad/`；
# `.wiki/` 是既有的同类产物目录，一并登记在同一段里。

# 协作智能体（小队实验）产物：智能体定义落在 <workspace>/.zcode/squad/（含 agents/ 子目录），
# 与现有 subagent 的 <workspace>/.zcode/agents 分离、可整块删除，属本地运行产物不入库。
.zcode/squad/

# 协作智能体的 project scope 记忆：<workspace>/.zcode/agent-memory/<稳定 id>/
# （apps/zcode-cli 的 persistent-memory.ts），与定义同属本地运行产物，不入库。
.zcode/agent-memory/

# 工作树产物：<repoRoot>/.worktree/<工作项>-<队员>/ 是整份仓库的副本（P2a 的隔离目录），
# 可再生。注意上面既有的 `.worktrees/` 是复数、不是本目录。
/.worktree/

# 项目知识库（wiki）产物：按项目落在 <workspace>/.wiki/，是可再生的生成物，
# 不应进入版本库（需要共享时由使用者自行决定是否强制添加）。
.wiki/

# SDD / brainstorming 视觉伴侣的本地工作目录（不入版本库）
.superpowers/
